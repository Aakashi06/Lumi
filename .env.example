# Local loopback endpoints only. No keys or hosted providers are used.
LUMI_DATABASE_URL=sqlite:///./data/lumi.db
LUMI_MODEL_URL=http://127.0.0.1:8080/v1
LUMI_MODEL_ID=Qwen3-4B-Instruct-2507
LUMI_EMBEDDING_URL=http://127.0.0.1:8081/v1
LUMI_EMBEDDING_ID=Qwen3-Embedding-0.6B
LUMI_CONTEXT_WINDOW=4096
LUMI_MAX_TOKENS=1400
LUMI_TEMPERATURE=0.1
LUMI_TIMEOUT=180

# Small, CPU-only graph extraction. SQLite requires no separate server.
LUMI_SPACY_MODEL=en_core_web_sm
LUMI_INITIAL_GRAPH_CHUNKS=4
LUMI_EXTRACTION_BATCH_SIZE=8
LUMI_GRAPH_NODE_LIMIT=75
LUMI_GRAPH_EXPANSION_LIMIT=200
# Optional semantic retrieval; disabled to reduce latency and RAM on 8GB Macs.
LUMI_ENABLE_EMBEDDINGS=false
